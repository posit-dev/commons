    {
      "name": "a physical column named like a reference marker does not shadow the reference",
      "backend": "snowflake",
      "identifier_case": "upper",
      "dictionary": {
        "tables": [
          {
            "name": "sales",
            "columns": [
              { "name": "id", "type": "number(quantity)" },
              {
                "name": "__COMMONS_DEFINITION_REFERENCE_001__",
                "type": "number(quantity)"
              }
            ],
            "definitions": [
              { "name": "base", "expr": "id > 0" },
              {
                "name": "flagged",
                "expr": "base AND __COMMONS_DEFINITION_REFERENCE_001__ > 0"
              }
            ]
          }
        ]
      },
      "relations": [
        {
          "label": "ANALYTICS.PUBLIC.SALES",
          "catalog": "ANALYTICS",
          "schema": "PUBLIC",
          "table": "SALES",
          "columns": [
            { "column": "ID", "type": "NUMBER(38,0)" },
            {
              "column": "__commons_definition_reference_001__",
              "type": "NUMBER(38,0)"
            }
          ]
        }
      ],
      "expect": {
        "tables": {
          "ANALYTICS.PUBLIC.SALES": {
            "base": "\"ID\" > 0",
            "flagged": "(\"ID\" > 0) AND \"__commons_definition_reference_001__\" > 0"
          }
        }
      }
    },
