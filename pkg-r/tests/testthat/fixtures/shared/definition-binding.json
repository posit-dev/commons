    {
      "name": "a mixed-grain metric is refused before a column the relation lacks",
      "backend": "snowflake",
      "identifier_case": "upper",
      "dictionary": {
        "tables": [
          {
            "name": "sales",
            "columns": [
              { "name": "id", "type": "number(quantity)" },
              { "name": "ghost", "type": "number(quantity)" }
            ],
            "definitions": [
              { "name": "flag", "expr": "id > avg(id)" },
              {
                "name": "flagged",
                "expr": "sum(case when flag then 1 else 0 end)"
              },
              { "name": "total", "expr": "sum(ghost)" }
            ]
          }
        ]
      },
      "relations": [
        {
          "label": "ANALYTICS.PUBLIC.SALES",
          "catalog": "ANALYTICS",
          "schema": "PUBLIC",
          "table": "SALES",
          "columns": [{ "column": "ID", "type": "NUMBER(38,0)" }]
        }
      ],
      "expect": { "error": "mixed_grain" }
    },
