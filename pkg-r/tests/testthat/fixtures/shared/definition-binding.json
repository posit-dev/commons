  "cases": [
    {
      "name": "a column is lowered with the spelling Snowflake reported",
      "backend": "snowflake",
      "identifier_case": "upper",
      "dictionary": {
        "tables": [
          {
            "name": "sales",
            "columns": [{ "name": "id", "type": "number(quantity)" }],
            "definitions": [
              { "name": "total", "expr": "sum(id)" },
              { "name": "doubled", "expr": "total * 2" }
            ]
          }
        ]
      },
      "relations": [
        {
          "label": "ANALYTICS.PUBLIC.SALES",
          "catalog": "ANALYTICS",
          "schema": "PUBLIC",
          "table": "SALES",
          "columns": [{ "column": "ID", "type": "NUMBER(38,0)" }]
        }
      ],
      "expect": {
        "tables": {
          "ANALYTICS.PUBLIC.SALES": {
            "total": "sum(\"ID\")",
            "doubled": "(sum(\"ID\")) * 2"
          }
        }
      }
    },
