{
  "description": "The values the system prompt template is rendered against, derived from an agent's sources, definitions, instructions, tools, and model. prompt-render.json pins what a renderer makes of such a mapping; this pins the mapping itself, so the two together stop the packages drifting. The source is tests/shared/prompt-data.json; the copy under pkg-r/tests/testthat/fixtures/shared/ is generated by scripts/sync-shared.sh. Edit the source and re-run that script.",
  "hydration": "Each source descriptor names an in-process DuckDB source: `tables` are the table names, each created from a one-column frame, and `dictionary` is an inline data-dict mapping attached to it. `catalog` builds the manifest a warehouse listing would leave behind, from `objects` relations labelled `label_prefix` followed by 1..objects with a namespace selected; `searchable` is what the manifest must then report, so a runner checks it rather than assuming it. A definition `label` of the form `pad:<n>` stands for n filler characters, which is how a case exceeds the 4000-character index cap without carrying 4 kB of text here.",
  "fields": [
    "date",
    "is_claude_5",
    "has_multiple_sources",
    "has_catalog_search",
    "has_dictionary_context",
    "has_glossary_context",
    "definitions_complete",
    "has_definitions",
    "has_complete_definitions",
    "tables",
    "dictionary_context",
    "glossary_context",
    "definition_index",
    "citation_trust_exception",
    "has_search_pool",
    "has_search_context",
    "has_describe_table",
    "has_run_sql",
    "has_call_measure",
    "has_call_metrics",
    "has_call_calculation",
    "has_run_r",
    "has_instructions",
    "instructions"
  ],
  "cases": [
    {
      "name": "one source lists its tables and switches every section off",
      "sources": [{ "name": "sales_db", "tables": ["orders", "customers"] }],
      "expect": {
        "is_claude_5": false,
        "has_multiple_sources": false,
        "has_catalog_search": false,
        "has_dictionary_context": false,
        "has_glossary_context": false,
        "definitions_complete": true,
        "has_definitions": false,
        "has_complete_definitions": false,
        "tables": "- orders\n- customers",
        "dictionary_context": "",
        "glossary_context": "",
        "definition_index": "",
        "citation_trust_exception": "",
        "has_run_sql": false,
        "has_instructions": false,
        "instructions": ""
      }
    },
    {
      "name": "one source's prose is headed by the dictionary's own name",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": {
            "name": "Retail sales",
            "description": "Orders from the retail system.",
            "details": "Excludes cancellations."
          }
        }
      ],
      "expect": {
        "has_dictionary_context": true,
        "has_glossary_context": false,
        "dictionary_context": "## Retail sales\n\nOrders from the retail system.\n\nExcludes cancellations.",
        "glossary_context": "",
        "tables": "- orders"
      }
    },
    {
      "name": "a nameless dictionary contributes prose with no heading",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": { "description": "Orders from the retail system." }
        }
      ],
      "expect": {
        "has_dictionary_context": true,
        "dictionary_context": "Orders from the retail system."
      }
    },
    {
      "name": "a glossary alone turns the dictionary section on",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": {
            "glossary": {
              "AOV": "Average order value.",
              "GMV": "Gross merchandise value."
            }
          }
        }
      ],
      "expect": {
        "has_dictionary_context": true,
        "has_glossary_context": true,
        "dictionary_context": "",
        "glossary_context": "- AOV: Average order value.\n- GMV: Gross merchandise value."
      }
    },
    {
      "name": "several sources are headed by their labels and dialects",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": {
            "name": "Retail sales",
            "description": "Orders from the retail system.",
            "glossary": { "AOV": "Average order value." }
          }
        },
        {
          "name": "crm",
          "tables": ["accounts"],
          "dictionary": { "description": "Accounts from the CRM." }
        }
      ],
      "expect": {
        "has_multiple_sources": true,
        "has_dictionary_context": true,
        "has_glossary_context": true,
        "tables": "## sales_db (duckdb)\n\n- orders\n\n## crm (duckdb)\n\n- accounts",
        "dictionary_context": "## sales_db\n\nOrders from the retail system.\n\n## crm\n\nAccounts from the CRM.",
        "glossary_context": "- sales_db — AOV: Average order value."
      }
    },
    {
      "name": "a searchable catalog replaces the table listing",
      "sources": [
        {
          "name": "warehouse",
          "tables": ["orders"],
          "catalog": {
            "label_prefix": "ANALYTICS.PUBLIC.TABLE_",
            "objects": 120,
            "searchable": true
          }
        }
      ],
      "expect": {
        "has_catalog_search": true,
        "tables": "120 selected catalog objects. Use `search_catalog` to find objects before calling `describe_table`."
      }
    },
    {
      "name": "a catalog small enough to list is not searchable",
      "sources": [
        {
          "name": "warehouse",
          "tables": ["orders", "customers"],
          "catalog": {
            "label_prefix": "ANALYTICS.PUBLIC.TABLE_",
            "objects": 3,
            "searchable": false
          }
        }
      ],
      "expect": {
        "has_catalog_search": false,
        "tables": "- orders\n- customers"
      }
    },
    {
      "name": "definitions under the cap are indexed in full",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": {
            "tables": [
              {
                "name": "orders",
                "columns": [
                  { "name": "status_cd", "type": "number(id)" },
                  { "name": "order_total", "type": "number(quantity)" }
                ],
                "definitions": [
                  {
                    "name": "net_revenue",
                    "label": "Net revenue",
                    "expr": "SUM(CASE WHEN status_cd = 90 THEN 0 ELSE order_total END)"
                  },
                  { "name": "is_open", "expr": "status_cd < 90" }
                ]
              }
            ]
          }
        }
      ],
      "expect": {
        "definitions_complete": true,
        "has_definitions": true,
        "has_complete_definitions": true,
        "has_dictionary_context": false,
        "definition_index": "- orders: filters `{{is_open}}`; metrics `{{net_revenue}}` (Net revenue)"
      }
    },
    {
      "name": "definitions on several sources are scoped by source",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders"],
          "dictionary": {
            "tables": [
              {
                "name": "orders",
                "columns": [
                  { "name": "order_total", "type": "number(quantity)" }
                ],
                "definitions": [
                  { "name": "net_revenue", "expr": "SUM(order_total)" }
                ]
              }
            ]
          }
        },
        {
          "name": "crm",
          "tables": ["accounts"],
          "dictionary": {
            "tables": [
              {
                "name": "accounts",
                "columns": [{ "name": "tier", "type": "string" }],
                "definitions": [
                  {
                    "name": "is_enterprise",
                    "label": "Enterprise tier",
                    "expr": "tier = 'Enterprise'"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expect": {
        "has_multiple_sources": true,
        "definitions_complete": true,
        "has_definitions": true,
        "has_complete_definitions": true,
        "definition_index": "- sales_db.orders: metrics `{{net_revenue}}`\n- crm.accounts: filters `{{is_enterprise}}` (Enterprise tier)"
      }
    },
    {
      "name": "an index over the cap keeps the lines that fit and reports incomplete",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["orders", "customers", "wide"],
          "dictionary": {
            "tables": [
              {
                "name": "orders",
                "columns": [
                  { "name": "order_total", "type": "number(quantity)" }
                ],
                "definitions": [
                  {
                    "name": "net_revenue",
                    "label": "Net revenue",
                    "expr": "SUM(order_total)"
                  }
                ]
              },
              {
                "name": "customers",
                "columns": [{ "name": "signed_up", "type": "date" }],
                "definitions": [
                  { "name": "is_active", "expr": "signed_up >= '2024-01-01'" }
                ]
              },
              {
                "name": "wide",
                "columns": [{ "name": "amount", "type": "number(quantity)" }],
                "definitions": [
                  {
                    "name": "padded",
                    "label": "pad:4000",
                    "expr": "SUM(amount)"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expect": {
        "definitions_complete": false,
        "has_definitions": true,
        "has_complete_definitions": false,
        "definition_index": "- orders: metrics `{{net_revenue}}` (Net revenue)\n- customers: filters `{{is_active}}`"
      }
    },
    {
      "name": "an index whose first line alone exceeds the cap is empty and incomplete",
      "sources": [
        {
          "name": "sales_db",
          "tables": ["wide"],
          "dictionary": {
            "tables": [
              {
                "name": "wide",
                "columns": [{ "name": "amount", "type": "number(quantity)" }],
                "definitions": [
                  {
                    "name": "padded",
                    "label": "pad:4000",
                    "expr": "SUM(amount)"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expect": {
        "definitions_complete": false,
        "has_definitions": true,
        "has_complete_definitions": false,
        "definition_index": ""
      }
    },
    {
      "name": "instructions, tools, and the model reach the prompt data",
      "sources": [{ "name": "sales_db", "tables": ["orders"] }],
      "instructions": "Prefer weekly grain.",
      "tools": ["run_sql", "call_measure"],
      "model": "claude-sonnet-5",
      "expect": {
        "is_claude_5": true,
        "has_instructions": true,
        "instructions": "Prefer weekly grain.",
        "has_run_sql": true,
        "has_call_measure": true,
        "has_search_pool": false,
        "citation_trust_exception": " that is not based solely on output from `call_measure`"
      }
    }
  ]
}
