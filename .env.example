# Connection variables for the live Snowflake and Databricks tests.
# Copy this file to .env and fill in the values; git ignores .env.
# tests/shared/live-warehouse-env.json lists the variables, and the schema
# and objects the tests expect, which scripts/provision-live-warehouse.py
# creates.
#
# Write plain KEY=value lines without `export`, with comments on lines of
# their own. ~ is not expanded, so use ${HOME} or an absolute path, and
# put a path with backslashes in single quotes.
# A backend whose required variables are unset skips its tests.

# Databricks.
DATABRICKS_HOST=https://example.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123

# Credentials: set one of the two choices below, or leave both unset to use
# a `databricks auth login` session.
#
# A personal access token.
# DATABRICKS_TOKEN=your-token
#
# A service principal's client secret.
# DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DATABRICKS_CLIENT_SECRET=your-client-secret

# Snowflake signs in with a key pair registered to SNOWFLAKE_USER.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=MY_USER
SNOWFLAKE_WAREHOUSE=MY_WH
SNOWFLAKE_PRIVATE_KEY_FILE=${HOME}/.snowflake/keys/rsa_key.p8
