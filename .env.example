# Connection variables for the live Snowflake and Databricks tests.
# Copy this file to .env and fill in the values; git ignores .env.
# tests/shared/live-warehouse-env.json describes each variable.
#
# Write plain KEY=value lines without `export`, with comments on lines of
# their own. ~ is not expanded, so use ${HOME} or an absolute path, and
# put a path with backslashes in single quotes.
# A backend whose required variables are unset skips its tests.

# Databricks.
DATABRICKS_HOST=https://example.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123
COMMONS_TEST_DATABRICKS_SCHEMA=main.commons_live

# Credentials: set one of the two choices below, or leave both unset to use
# a `databricks auth login` session.
#
# A personal access token.
# DATABRICKS_TOKEN=your-token
#
# A service principal's client secret. Set the scopes to sql when the
# secret is scoped to sql.
# DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DATABRICKS_CLIENT_SECRET=your-client-secret
# COMMONS_TEST_DATABRICKS_SCOPES=sql

# A table the test principal cannot read, for the permission tests.
# COMMONS_TEST_DATABRICKS_DENIED_TABLE=main.commons_live.denied

# A metric view with a parameter, and its arguments as JSON (R suite only).
# COMMONS_TEST_DATABRICKS_PARAMETERIZED_MODEL=main.commons_live.sales_model
# COMMONS_TEST_DATABRICKS_PARAMETERIZED_MODEL_ARGUMENTS='{"threshold": 100}'

# Snowflake signs in with a key pair registered to SNOWFLAKE_USER.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=MY_USER
SNOWFLAKE_WAREHOUSE=MY_WH
SNOWFLAKE_PRIVATE_KEY_FILE=${HOME}/.snowflake/keys/rsa_key.p8
COMMONS_TEST_SNOWFLAKE_SCHEMA=COMMONS_CI.PUBLIC

# A table the test role cannot read, for the permission tests.
# COMMONS_TEST_SNOWFLAKE_DENIED_TABLE=COMMONS_CI.PUBLIC.DENIED

# A second usable role, for the active-role change test.
# COMMONS_TEST_SNOWFLAKE_ALTERNATE_ROLE=MY_OTHER_ROLE

# Semantic views for the semantic-model tests (R suite only).
# COMMONS_TEST_SNOWFLAKE_SEMANTIC_VIEW=ANALYTICS.PUBLIC.SALES_VIEW
# COMMONS_TEST_SNOWFLAKE_VERIFIED_QUERY_VIEW=ANALYTICS.PUBLIC.VERIFIED_VIEW

# A semantic view with a variable, and its arguments as JSON (R suite only).
# COMMONS_TEST_SNOWFLAKE_PARAMETERIZED_MODEL=ANALYTICS.PUBLIC.SALES_MODEL
# COMMONS_TEST_SNOWFLAKE_PARAMETERIZED_MODEL_ARGUMENTS='{"threshold": 100}'
