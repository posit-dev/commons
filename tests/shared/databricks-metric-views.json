{
  "description": "How a Databricks metric view is read. Its YAML definition lists the dimensions (`fields` and `dimensions`) and measures the model is offered, the tables it reads (`source` and the `joins` beneath it), its typed `parameters`, and the prose that becomes first-touch and retrieval context. A member written without a name is a wildcard, expanded from the view's column metadata. Both packages read the same definition into the same model.",
  "specifications": {
    "description": "A view's id, its YAML definition, the column metadata `DESCRIBE TABLE EXTENDED ... AS JSON` reports when the case has `columns`, and the model read from them. `description` is the catalog comment, used when the YAML has no `comment`. A dependency is a three-part name, parsed as `qualified_names` pins; a source that is not one, such as a query, leaves the dependencies incomplete. The view's `filter` is SQL it always applies, so it is described in the context and is not a member. `expected` is the model, `unsupported` with the names the reason must mention, or an error.",
    "cases": [
      {
        "name": "joins, a filter, and prose become dependencies and context",
        "id": {
          "catalog": "main",
          "schema": "sales",
          "table": "order_metrics"
        },
        "yaml": "version: 1.1\ncomment: Governed order metrics.\nai_context: Treat returned orders as active.\nsource: main.sales.orders\nfilter: source.is_active\njoins:\n  - name: customer\n    source: main.sales.customers\n    on: source.customer_id = customer.id\n    cardinality: many_to_one\n    joins:\n      - name: region\n        source: \"`main`.`sales`.`sales regions`\"\n        using: [region_id]\nfields:\n  - name: region\n    expr: region.name\n    display_name: Region\n    comment: Sales region.\n    synonyms: [territory]\nmeasures:\n  - name: revenue\n    expr: SUM(source.revenue)\n    comment: Booked revenue.\n",
        "expected": {
          "name": "order_metrics",
          "description": "Governed order metrics.",
          "dimensions": [
            {
              "name": "region",
              "kind": "dimension",
              "parent": null,
              "label": "Region",
              "description": "Sales region.",
              "type": null,
              "synonyms": [
                "territory"
              ],
              "filter": false
            }
          ],
          "metrics": [
            {
              "name": "revenue",
              "kind": "metric",
              "parent": null,
              "label": null,
              "description": "Booked revenue.",
              "type": null,
              "synonyms": [],
              "filter": false
            }
          ],
          "facts": [],
          "filters": [],
          "parameters": {},
          "dependencies": [
            {
              "catalog": "main",
              "schema": "sales",
              "table": "orders"
            },
            {
              "catalog": "main",
              "schema": "sales",
              "table": "customers"
            },
            {
              "catalog": "main",
              "schema": "sales",
              "table": "sales regions"
            }
          ],
          "dependencies_complete": true,
          "first_touch": [
            "Governed order metrics.",
            "Treat returned orders as active.",
            "Metric-view filter: source.is_active",
            "Metric-view relationship `customer` joins `main.sales.customers` with many_to_one cardinality.",
            "Metric-view relationship `region` joins ``main`.`sales`.`sales regions`` on using region_id."
          ],
          "retrieval": [
            "Governed order metrics.",
            "Treat returned orders as active.",
            "Metric-view filter: source.is_active",
            "Metric-view relationship `customer` joins `main.sales.customers` with many_to_one cardinality.",
            "Metric-view relationship `region` joins ``main`.`sales`.`sales regions`` on using region_id."
          ]
        }
      },
