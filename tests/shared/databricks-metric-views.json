  "qualified_names": {
    "description": "A dotted name split into its parts. A backtick-quoted part keeps dots and spaces, and a doubled backtick inside one is a backtick. Unquoted whitespace or an unclosed quote makes it no name at all, which is an empty list.",
    "cases": [
      {
        "value": "main.sales.orders",
        "parts": [
          "main",
          "sales",
          "orders"
        ]
      },
      {
        "value": "`main`.`sales`.`sales regions`",
        "parts": [
          "main",
          "sales",
          "sales regions"
        ]
      },
      {
        "value": "`a``b`.c.d",
        "parts": [
          "a`b",
          "c",
          "d"
        ]
      },
      {
        "value": "main.sales",
        "parts": [
          "main",
          "sales"
        ]
      },
      {
        "value": "main . sales.orders",
        "parts": []
      },
      {
        "value": "`unclosed.sales.orders",
        "parts": []
      },
      {
        "value": "main.sales.orders.extra",
        "parts": [
          "main",
          "sales",
          "orders",
          "extra"
        ]
      }
    ]
  },
  "type_text": {
    "description": "A column's type, as metadata reports it, written as the member's type. A string is kept. A structured type is written by name, with its precision and scale or its length where the type has them. Anything else has no type.",
