  "resolution": {
    "description": "Resolving names against the registry as one kind of member. `filter` resolves only the members labelled as filters. Braces around a name, as the SQL token syntax writes it, are ignored. `expected` is the keys resolved, in order, or an error: `ambiguous` when more than one member of the kind answers to the name, `wrong_kind` when members answer to it but none of the kind, and `missing` when none does.",
    "cases": [
      {
        "names": [
          "revenue"
        ],
        "kind": "metric",
        "expected": {
          "error": "ambiguous",
          "mentions": [
            "revenue",
            "REVENUE::orders.revenue",
            "FINANCE::ledger.revenue"
          ]
        }
      },
      {
        "names": [
          "REVENUE::revenue"
        ],
        "kind": "metric",
        "expected": {
          "keys": [
            "REVENUE::orders.revenue"
          ]
        }
      },
      {
        "names": [
          "orders.revenue"
        ],
        "kind": "metric",
        "expected": {
          "keys": [
            "REVENUE::orders.revenue"
          ]
        }
      },
      {
        "names": [
          "FINANCE::ledger.revenue",
          "{{order_count}}"
        ],
        "kind": "metric",
        "expected": {
          "keys": [
            "FINANCE::ledger.revenue",
            "REVENUE::order_count"
          ]
        }
      },
      {
        "names": [
          "region"
        ],
        "kind": "metric",
        "expected": {
          "error": "wrong_kind",
          "mentions": [
            "region",
            "native dimension"
          ]
        }
      },
      {
        "names": [
          "nope"
        ],
        "kind": "metric",
        "expected": {
          "error": "missing",
          "mentions": [
            "nope",
            "revenue",
            "order_count"
          ]
        }
      },
      {
        "names": [
          "region"
        ],
        "kind": "dimension",
        "expected": {
          "error": "ambiguous",
          "mentions": [
            "region",
            "REVENUE::orders.region",
            "FINANCE::ledger.region"
          ]
        }
      },
      {
        "names": [
          "ledger.region"
        ],
        "kind": "dimension",
        "expected": {
          "keys": [
            "FINANCE::ledger.region"
          ]
        }
      },
      {
        "names": [
          "amount"
        ],
        "kind": "dimension",
        "expected": {
          "error": "wrong_kind",
          "mentions": [
            "amount",
            "native fact"
          ]
        }
      },
      {
        "names": [
          "recent_only"
        ],
        "kind": "dimension",
        "expected": {
          "error": "missing",
          "mentions": [
            "recent_only",
            "region",
            "active_only"
          ]
        }
      },
      {
        "names": [
          "active_only",
          "amount"
        ],
        "kind": "filter",
        "expected": {
          "keys": [
            "REVENUE::orders.active_only",
            "REVENUE::orders.amount"
          ]
        }
      },
      {
        "names": [
          "region"
        ],
        "kind": "filter",
        "expected": {
          "error": "missing",
          "mentions": [
            "region",
            "active_only",
            "amount"
          ]
        }
      }
    ]
  },
  "metric_origin": {
    "description": "Which pool a metric name belongs to when data-dict metric definitions and native semantic metrics share a source. A definition answers to `name` or `table::name`. A name both pools answer to is ambiguous, and must be qualified.",
    "cases": [
      {
        "name": "net_revenue",
        "expected": {
          "origin": "definition"
        }
      },
      {
        "name": "sales::net_revenue",
        "expected": {
          "origin": "definition"
        }
      },
      {
        "name": "REVENUE::revenue",
        "expected": {
          "origin": "semantic_model"
        }
      },
      {
        "name": "order_count",
        "expected": {
          "error": "ambiguous",
          "mentions": [
            "order_count",
            "sales::order_count",
            "REVENUE::order_count"
          ]
        }
      },
      {
        "name": "emea",
        "expected": {
          "error": "wrong_kind",
          "mentions": [
            "emea",
            "filter"
          ]
        }
      },
      {
        "name": "region",
        "expected": {
          "error": "wrong_kind",
          "mentions": [
            "region",
            "dimension"
          ]
        }
      },
      {
        "name": "nothing",
        "expected": {
          "error": "missing",
          "mentions": [
            "nothing",
            "net_revenue",
            "order_count",
            "revenue"
          ]
        }
      }
    ]
  }
}
