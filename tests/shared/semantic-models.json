{
  "description": "How a warehouse's semantic models become names an agent can call. Every source's models feed one registry of members: each model's dimensions and metrics, and the facts labelled as filters. A member answers to its bare name, to `parent.name`, and to either qualified by its model as `MODEL::name` or `MODEL::parent.name`; the last of these is its key. Errors are pinned as a kind and the names the message must mention, since the wording belongs to each language.",
  "models": {
    "description": "The models every case below reads, all on the source `warehouse`, with the governed data-dict definitions on the same source. Members not given a parent belong to no logical table.",
    "values": [
      {
        "label": "REVENUE",
        "dimensions": [
          {
            "name": "region",
            "parent": "orders",
            "description": "Sales region."
          },
          {
            "name": "active_only",
            "parent": "orders",
            "filter": true
          }
        ],
        "metrics": [
          {
            "name": "revenue",
            "parent": "orders",
            "label": "Revenue",
            "description": "Booked revenue."
          },
          {
            "name": "order_count"
          }
        ],
        "facts": [
          {
            "name": "amount",
            "parent": "orders",
            "filter": true
          },
          {
            "name": "cost",
            "parent": "orders"
          }
        ],
        "filters": [
          {
            "name": "recent_only",
            "parent": "orders"
          }
        ]
      },
      {
        "label": "FINANCE",
        "dimensions": [
          {
            "name": "region",
            "parent": "ledger"
          }
        ],
        "metrics": [
          {
            "name": "revenue",
            "parent": "ledger"
          }
        ],
        "facts": [],
        "filters": []
      }
    ],
    "definitions": [
      {
        "name": "net_revenue",
        "table": "sales",
        "kind": "metric"
      },
      {
        "name": "order_count",
        "table": "sales",
        "kind": "metric"
      },
      {
        "name": "emea",
        "table": "sales",
        "kind": "filter"
      }
    ]
  },
