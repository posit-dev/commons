{
  "description": "Python's remote MCP envelope schema and examples, plus provenance exchanges run through both packages' derive_provenance_tag(). R has no remote MCP runtime, so it tests only the shared provenance cases. The source is tests/shared/mcp-contract.json; the copy under pkg-r/tests/testthat/fixtures/shared/ is generated by scripts/sync-shared.sh.",
  "execution_kinds": {
    "trusted_calculation": "A",
    "ad_hoc_sql": "B",
    "metadata": null
  },
  "success_schema": {
    "type": "object",
    "required": [
      "data",
      "commons"
    ],
    "additionalProperties": false,
    "properties": {
      "data": {},
      "commons": {
        "type": "object",
        "required": [
          "contract_version",
          "catalog_revision",
          "tool_id",
          "execution_kind",
          "provenance_tag",
          "sources",
          "applied_definitions",
          "evidence",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "1"
          },
          "catalog_revision": {
            "type": "string",
            "minLength": 1
          },
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_kind": {
            "enum": [
              "trusted_calculation",
              "ad_hoc_sql",
              "metadata"
            ]
          },
          "provenance_tag": {
            "enum": [
              "A",
              "B",
              null
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applied_definitions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "uri",
                "revision"
              ],
              "additionalProperties": false,
              "properties": {
                "uri": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                }
              }
            }
          },
          "coverage": {
            "type": "object",
            "required": [
              "truncated"
            ],
            "additionalProperties": false,
            "properties": {
              "truncated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "name": "approved revenue calculation",
      "envelope": {
        "data": {
          "revenue": 500.0,
          "currency": "USD"
        },
        "commons": {
          "contract_version": "1",
          "catalog_revision": "sales-r17",
          "tool_id": "revenue",
          "execution_kind": "trusted_calculation",
          "provenance_tag": "A",
          "sources": [
            "warehouse"
          ],
          "applied_definitions": [
            "orders::net_revenue"
          ],
          "evidence": [
            {
              "uri": "commons://sources/warehouse/data-dict.yaml",
              "revision": "sales-r17"
            }
          ],
          "coverage": {
            "truncated": false
          }
        }
      }
    },
    {
      "name": "custom SQL result",
      "envelope": {
        "data": {
          "columns": [
            "total_revenue"
          ],
          "rows": [
            [
              500.0
            ]
          ]
        },
        "commons": {
          "contract_version": "1",
          "catalog_revision": "sales-r17",
          "tool_id": "run_sql",
          "execution_kind": "ad_hoc_sql",
          "provenance_tag": "B",
          "sources": [
            "warehouse"
          ],
          "applied_definitions": [],
          "evidence": [],
          "coverage": {
            "truncated": false
          }
        }
      }
    },
    {
      "name": "metadata result",
      "envelope": {
        "data": {
          "table": "orders",
          "columns": [
            {
              "name": "net_revenue",
              "type": "DOUBLE"
            }
          ]
        },
        "commons": {
          "contract_version": "1",
          "catalog_revision": "sales-r17",
          "tool_id": "describe_table",
          "execution_kind": "metadata",
          "provenance_tag": null,
          "sources": [
            "warehouse"
          ],
          "applied_definitions": [],
          "evidence": [
            {
              "uri": "commons://sources/warehouse/data-dict.yaml",
              "revision": "sales-r17"
            }
          ],
          "coverage": {
            "truncated": false
          }
        }
      }
    }
  ],
  "invalid_examples": [
    {
      "name": "SQL cannot claim trusted calculation",
      "expected_tool": "run_sql",
      "expected_execution_kind": "ad_hoc_sql",
      "schema_valid": true,
      "envelope": {
        "data": {
          "rows": []
        },
        "commons": {
          "contract_version": "1",
          "catalog_revision": "sales-r17",
          "tool_id": "run_sql",
          "execution_kind": "ad_hoc_sql",
          "provenance_tag": "A",
          "sources": [
            "warehouse"
          ],
          "applied_definitions": [],
          "evidence": [],
          "coverage": {
            "truncated": false
          }
        }
      }
    },
    {
      "name": "metadata cannot claim a calculation tag",
      "expected_tool": "describe_table",
      "expected_execution_kind": "metadata",
      "schema_valid": false,
      "envelope": {
        "data": {
          "table": "orders"
        },
        "commons": {
          "contract_version": "1",
          "catalog_revision": "sales-r17",
          "tool_id": "describe_table",
          "execution_kind": "metadata",
          "provenance_tag": "C",
          "sources": [
            "warehouse"
          ],
          "applied_definitions": [],
          "evidence": [],
          "coverage": {
            "truncated": false
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "tools": ["revenue"],
      "verified": false,
      "expected_tag": "A"
    },
    {
      "tools": ["run_sql"],
      "verified": false,
      "expected_tag": "C"
    },
    {
      "tools": ["run_sql"],
      "verified": true,
      "expected_tag": "B"
    },
    {
      "tools": ["revenue", "run_sql"],
      "verified": false,
      "expected_tag": "C"
    },
    {
      "tools": ["describe_table"],
      "verified": false,
      "expected_tag": null
    },
    {
      "name": "verified fallback over a trusted calculation remains B",
      "tools": ["revenue", "run_sql"],
      "expected_input_tags": ["A", "B"],
      "verified": true,
      "expected_tag": "B"
    }
  ]
}
