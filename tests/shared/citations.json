{
  "description": "Citation normalization and corpus matching, shared by pkg-r and pkg-py. The source is tests/shared/citations.json; the copy under pkg-r/tests/testthat/fixtures/shared/ is generated by scripts/sync-shared-fixtures.sh. Edit the source and re-run that script.",
  "normalize_citation": {
    "description": "Forgives the ways a faithful quote can still drift from its source: markdown emphasis, typographic quotes and dashes, and reflowed whitespace. Case is never folded, because match_citation is case-sensitive.",
    "cases": [
      {
        "name": "asterisk emphasis is stripped",
        "input": "Revenue *excludes* tax.",
        "expected": "Revenue excludes tax."
      },
      {
        "name": "underscore emphasis is stripped",
        "input": "Revenue _excludes_ tax.",
        "expected": "Revenue excludes tax."
      },
      {
        "name": "backticks are stripped",
        "input": "Revenue `excludes` tax.",
        "expected": "Revenue excludes tax."
      },
      {
        "name": "curly single quotes fold to ascii",
        "input": "the finance team\u2019s \u2018rule\u2019",
        "expected": "the finance team's 'rule'"
      },
      {
        "name": "curly double quotes fold to ascii",
        "input": "he said \u201chello\u201d loudly",
        "expected": "he said \"hello\" loudly"
      },
      {
        "name": "em dash folds to hyphen",
        "input": "Revenue excludes tax \u2014 always.",
        "expected": "Revenue excludes tax - always."
      },
      {
        "name": "en dash folds to hyphen",
        "input": "Revenue excludes tax \u2013 always.",
        "expected": "Revenue excludes tax - always."
      },
      {
        "name": "reflowed whitespace collapses",
        "input": "Revenue excludes\n  tax - always.",
        "expected": "Revenue excludes tax - always."
      },
      {
        "name": "leading and trailing whitespace is trimmed",
        "input": "  Revenue excludes tax.\t",
        "expected": "Revenue excludes tax."
      },
      {
        "name": "a non-breaking space is whitespace",
        "input": "Revenue\u00a0excludes tax.",
        "expected": "Revenue excludes tax."
      },
      {
        "name": "case is never folded",
        "input": "Revenue Excludes Tax.",
        "expected": "Revenue Excludes Tax."
      },
      {
        "name": "empty input stays empty",
        "input": "",
        "expected": ""
      },
      {
        "name": "whitespace-only input becomes empty",
        "input": " \t\n ",
        "expected": ""
      }
    ]
  },
  "whitespace": {
    "description": "Which codepoints normalize_citation treats as whitespace, as hex. This is the Unicode White_Space set, spelled out in both implementations rather than left to either regex engine's shorthand. R's default engine consults locale-dependent C library classification and Python's is Unicode-aware, so the same quote could otherwise verify in one language and not the other. Runners build the character from the hex and check it collapses, or does not, in leading, interior and trailing position.",
    "collapsed": [
      "0009",
      "000A",
      "000B",
      "000C",
      "000D",
      "0020",
      "0085",
      "00A0",
      "1680",
      "2000",
      "2001",
      "2002",
      "2003",
      "2004",
      "2005",
      "2006",
      "2007",
      "2008",
      "2009",
      "200A",
      "2028",
      "2029",
      "202F",
      "205F",
      "3000"
    ],
    "preserved": [
      "001C",
      "001D",
      "001E",
      "001F",
      "180E",
      "200B",
      "FEFF"
    ]
  },
  "match_citation": {
    "description": "First match wins, because the corpus is ordered specific before general. Matching is case-sensitive substring containment after normalizing both sides. `expected` is null when nothing verifies, otherwise the label and kind of the entry that did.",
    "min_normalized_length": 10,
    "guard": "A quote whose normalized form is shorter than 10 characters never verifies, so a trivial fragment cannot promote an unsupported answer. Only the quote is ever passed here; the model's explanation is never verified.",
    "cases": [
      {
        "name": "matching forgives reflowed whitespace and typography",
        "quote": "Revenue excludes\n  tax - always.",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue *excludes* tax \u2014 always."
          }
        ],
        "expected": {
          "label": "documentation",
          "kind": "prose"
        }
      },
      {
        "name": "a trivial quote cannot promote an answer",
        "quote": "tax",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": null
      },
      {
        "name": "nine normalized characters is too short",
        "quote": "Revenue e",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": null
      },
      {
        "name": "ten normalized characters is long enough",
        "quote": "Revenue ex",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": {
          "label": "documentation",
          "kind": "prose"
        }
      },
      {
        "name": "the length guard counts the normalized form, not the input",
        "quote": "*R*e*v*e*n*u*e* *e*x*",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": {
          "label": "documentation",
          "kind": "prose"
        }
      },
      {
        "name": "matching is case-sensitive",
        "quote": "revenue excludes tax.",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": null
      },
      {
        "name": "the first matching entry wins",
        "quote": "Revenue excludes tax.",
        "corpus": [
          {
            "label": "orders table",
            "kind": "schema",
            "text": "Revenue excludes tax."
          },
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": {
          "label": "orders table",
          "kind": "schema"
        }
      },
      {
        "name": "a later entry matches when earlier ones do not",
        "quote": "Fiscal year starts in February.",
        "corpus": [
          {
            "label": "orders table",
            "kind": "schema",
            "text": "Revenue excludes tax."
          },
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Fiscal year starts in February."
          }
        ],
        "expected": {
          "label": "documentation",
          "kind": "prose"
        }
      },
      {
        "name": "an unsupported quote verifies against nothing",
        "quote": "Revenue includes tax.",
        "corpus": [
          {
            "label": "documentation",
            "kind": "prose",
            "text": "Revenue excludes tax."
          }
        ],
        "expected": null
      },
      {
        "name": "an empty corpus verifies nothing",
        "quote": "Revenue excludes tax.",
        "corpus": [],
        "expected": null
      },
      {
        "name": "a definition entry keeps its kind",
        "quote": "Count orders, optionally filtered by region.",
        "corpus": [
          {
            "label": "order_count definition",
            "kind": "definition",
            "text": "Count orders, optionally filtered by region."
          }
        ],
        "expected": {
          "label": "order_count definition",
          "kind": "definition"
        }
      }
    ]
  }
}
